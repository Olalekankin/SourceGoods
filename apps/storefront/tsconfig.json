{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@workspace/api-client-react": ["../../packages/api-client-react/dist/index.d.ts"],
      "@workspace/api-client-react/*": ["../../packages/api-client-react/dist/*"],
      "@workspace/api-zod": ["../../packages/api-zod/dist/index.d.ts"],
      "@workspace/api-zod/*": ["../../packages/api-zod/dist/*"],
      "@workspace/db": ["../../packages/db/dist/index.d.ts"],
      "@workspace/db/*": ["../../packages/db/dist/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
